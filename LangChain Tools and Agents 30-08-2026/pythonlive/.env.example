# Copy this file to .env and fill in your own keys.
#   cp .env.example .env

# Required for the OpenAI examples, including image generation
# Get one from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Required only for hf-demo.py
# Get one from https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=hf_your-token-here

# ollama-demo.py needs no key. Install Ollama and run: ollama pull mistral

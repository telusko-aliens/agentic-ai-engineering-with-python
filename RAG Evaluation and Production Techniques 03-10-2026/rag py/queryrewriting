# my question may be complete but worded diff from the doc
#example user: "money user" Doc: "refund"

class Variations(BaseModel):
    """
    Structured output containing alternative phrasings.
    """

    # The LLM must return a list of three queries.
    queries: list[str] = Field(
        description="Three different phrasings of the question"
    )

variation_model = ChatOpenAI(model="gpt-4o-mini",temperature=0).with_structured_output(Variations)


# MULTI-QUERY FUNCTION
# ===========================================================================

def multi_query(question, k=3):
    """
    Search with several phrasings and merge,
    keeping the first sight of each chunk.
    """

    # -----------------------------------------------------------------------
    # STEP 1: GENERATE QUERY VARIATIONS
    # -----------------------------------------------------------------------
    #
    # The LLM is asked for three alternate ways
    # to search for the same meaning.
    result = variation_model.invoke(

        "Write three different search queries for this question. Vary the wording "
        "and the vocabulary, keep the meaning.\n\nQuestion: " + question
    )


    # -----------------------------------------------------------------------
    # STEP 2: INCLUDE THE ORIGINAL QUERY TOO
    # -----------------------------------------------------------------------
    #
    # Important:
    #
    # We do NOT throw away the original user query.
    #
   # We search with:
    #
    # original query
    # +
    # 3 generated queries
    #
    # Total = 4 queries.
    all_queries = [
        question,
        *result.queries
    ]


    # -----------------------------------------------------------------------
    # STEP 3: MERGE RESULTS
    # -----------------------------------------------------------------------
    #
    # Different queries may retrieve the same chunk.
    #
    # Example:
    #
    # query 1 -> refunds chunk A
    # query 2 -> refunds chunk A
    # query 3 -> refunds chunk B
    #
    #
    # We don't want duplicate copies of chunk A.
    #
    # So we use a dictionary.
    merged = {}


    # Search once for every query variation.
    for query in all_queries:


        # Perform direct vector similarity search.
        #
        # Each query returns top k chunks.
        for doc in store.similarity_search(
            query,
            k=k
        ):


            # Use page_content as the key.
            #
            # If this exact chunk was already seen,
            # keep the existing copy.
            #
            # setdefault means:
            #
            # "only insert this key if it doesn't already exist."
            merged.setdefault(
                doc.page_content,
                doc
            )


    # Return:
    #
    # 1. all queries used
    # 2. unique retrieved chunks
    return (
        all_queries,
        list(merged.values())
    )

question = "money back"
queries, merged = multi_query(question)

print("Vague question:", question)
print("Searched with:")
for query in queries:
    print("   -", query)
print()
show(f"one query returned {len(retriever.invoke(question))} chunks:", retriever.invoke(question))
show(f"four queries merged into {len(merged)} chunks:", merged)

# Copy this file to .env and fill in your own key.
#   cp .env.example .env

# Required by every script here: embeddings, the vector store and the RAG chain
# Get one from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# The Gemini and Hugging Face lines in emb-provider.py are commented out.
# Uncomment them only if you also set the matching key below.
# GOOGLE_API_KEY=your-gemini-key-here
